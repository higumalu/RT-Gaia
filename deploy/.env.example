# Copy to deploy/.env and edit. See docs/administration.md for every setting.
RTGAIA_SECRET=change-me-to-a-long-random-string
POSTGRES_PASSWORD=rtgaia
RTGAIA_HTTP_PORT=80
# Public address (required): browsers and plugin services reach RT-Gaia here; the trusted Host list is derived from it.
RTGAIA_PUBLIC_URL=http://localhost
# Trusted Host values (comma-separated). Setting this REPLACES the default list (the PUBLIC_URL host, localhost,
# 127.0.0.1), so include the PUBLIC_URL host yourself.
# RTGAIA_ALLOWED_HOSTS=rtgaia.example.org,localhost,127.0.0.1
# Resource limits (optional; defaults in packages/rtgaia-core/src/rtgaia_core/limits.py)
# RTGAIA_IMPORT_BODY_MAX_BYTES=4294967296
# RTGAIA_ZIP_TOTAL_MAX_BYTES=8589934592
# RTGAIA_PLUGIN_ARTIFACT_MAX_BYTES=2147483648
# RTGAIA_RENDER_PIXEL_BUDGET=64000000
# RTGAIA_CPU_WORKERS=4

# ── DICOM receiver: these are defaults only; values changed in the admin pages (Service settings) are stored in the
#    database and take precedence ──
# RTGAIA_AE_TITLE=RTGAIA
# RTGAIA_SCP=1            # receiver inside the API process; with a separate rtgaia-scp process set RTGAIA_SCP_OWNER=0 for the API
# RTGAIA_SCP_PORT=11112
# RTGAIA_SCP_HOST=0.0.0.0
