__pycache__/
*.py[cod]
.venv/
.uv-cache/
dist/
build/
*.egg-info/
node_modules/
apps/viewer/dist/
target/
.cache/
**/fixtures/cache/
packages/rtgaia-testbe/src/rtgaia_testbe/fixtures/dicom/*
